  oferta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#F4B183"><b>OFERTA</b></td></tr><tr><td align="left" port="id"><font point-size="9">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="id_vendedor"><font point-size="9">FK</font></td><td align="left">id_vendedor</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="codigo_mercado"><font point-size="9">FK</font></td><td align="left">codigo_mercado</td><td align="left"><font color="#555555">varchar</font></td></tr><tr><td align="left" port="numero_puesto"><font point-size="9"> </font></td><td align="left">numero_puesto</td><td align="left"><font color="#555555">varchar ?</font></td></tr><tr><td align="left" port="codigo_producto"><font point-size="9">FK</font></td><td align="left">codigo_producto</td><td align="left"><font color="#555555">varchar</font></td></tr><tr><td align="left" port="monto"><font point-size="9"> </font></td><td align="left">monto</td><td align="left"><font color="#555555">double</font></td></tr><tr><td align="left" port="presentacion"><font point-size="9"> </font></td><td align="left">presentacion</td><td align="left"><font color="#555555">varchar</font></td></tr><tr><td align="left" port="precio_por_unidad_base"><font point-size="9"> </font></td><td align="left">precio_por_unidad_base</td><td align="left"><font color="#555555">double</font></td></tr><tr><td align="left" port="desde"><font point-size="9"> </font></td><td align="left">desde</td><td align="left"><font color="#555555">timestamptz</font></td></tr><tr><td align="left" port="hasta"><font point-size="9"> </font></td><td align="left">hasta</td><td align="left"><font color="#555555">timestamptz</font></td></tr><tr><td align="left" port="nota"><font point-size="9"> </font></td><td align="left">nota</td><td align="left"><font color="#555555">varchar</font></td></tr><tr><td align="left" port="estado"><font point-size="9"> </font></td><td align="left">estado</td><td align="left"><font color="#555555">varchar</font></td></tr><tr><td colspan="3" align="left"><font point-size="8" color="#548235"><i>+ 5 campos de auditoría</i></font></td></tr></table>>];
  confirmacion_oferta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#F4B183"><b>CONFIRMACION_OFERTA</b></td></tr><tr><td align="left" port="id"><font point-size="9">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="id_oferta"><font point-size="9">FK</font></td><td align="left">id_oferta</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="id_usuario"><font point-size="9">FK</font></td><td align="left">id_usuario</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="la_vio_asi"><font point-size="9"> </font></td><td align="left">la_vio_asi</td><td align="left"><font color="#555555">bool</font></td></tr><tr><td colspan="3" align="left"><font point-size="8" color="#548235"><i>+ 5 campos de auditoría</i></font></td></tr></table>>];
  oferta -> confirmacion_oferta:id_oferta:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  usuario -> confirmacion_oferta:id_usuario:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  fuente -> fuente:deriva_de:w [dir=both, arrowhead=crowodot, arrowtail=tee];
  lista_compras -> item_lista_compras:id_lista:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  usuario -> lista_compras:id_usuario:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  mercado -> mercado:codigo_padre:w [dir=both, arrowhead=crowodot, arrowtail=tee];
  fuente -> observacion_precio:fuente:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  observacion_precio -> observacion_precio:revisa_a:w [dir=both, arrowhead=crowodot, arrowtail=tee];
  mercado -> oferta:codigo_mercado:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  producto -> oferta:codigo_producto:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  usuario -> oferta:id_vendedor:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  usuario -> puesto:id_vendedor:w [dir=both, arrowhead=crowodot, arrowtail=tee];
  mercado -> puesto:codigo_mercado:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  usuario -> reporte_precio:id_revisor:w [dir=both, arrowhead=crowodot, arrowtail=tee];
  usuario -> reporte_precio:id_autor:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  permiso -> rol_permiso:codigo_permiso:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  rol -> rol_permiso:codigo_rol:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  rol -> usuario:rol:w [dir=both, arrowhead=crowtee, arrowtail=tee];
  usuario -> vendedor:id_usuario:w [dir=both, arrowhead=tee, arrowtail=tee];
  mercado -> vendedor:codigo_punto_venta:w [dir=both, arrowhead=crowodot, arrowtail=tee];
  producto -> observacion_precio:codigo_producto:w [dir=both, arrowhead=crowtee, arrowtail=tee, style=dashed];
  mercado -> observacion_precio:codigo_mercado:w [dir=both, arrowhead=crowodot, arrowtail=tee, style=dashed];
  producto -> reporte_precio:codigo_producto:w [dir=both, arrowhead=crowtee, arrowtail=tee, style=dashed];
  mercado -> reporte_precio:codigo_mercado:w [dir=both, arrowhead=crowtee, arrowtail=tee, style=dashed];
  producto -> item_lista_compras:codigo_producto:w [dir=both, arrowhead=crowtee, arrowtail=tee, style=dashed];
  fuente -> corrida_fuente:fuente:w [dir=both, arrowhead=crowtee, arrowtail=tee, style=dashed];
  fuente -> intento_fuente:fuente:w [dir=both, arrowhead=crowtee, arrowtail=tee, style=dashed];
  leyenda [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#E2EFDA"><b>Leyenda</b></td></tr><tr><td align="left">PK / FK</td><td align="left">clave primaria / clave foránea declarada</td></tr><tr><td align="left">FK*</td><td align="left">referencia lógica sin restricción en la base (línea punteada)</td></tr><tr><td align="left">tipo ?</td><td align="left">admite nulo</td></tr><tr><td align="left">pata de gallo</td><td align="left">lado "muchos"; con círculo = opcional</td></tr><tr><td align="left" bgcolor="#A9D08E">verde</td><td align="left">catálogos</td></tr><tr><td align="left" bgcolor="#9DC3E6">azul</td><td align="left">precios y recolección</td></tr><tr><td align="left" bgcolor="#F4B183">naranja</td><td align="left">personas y operación</td></tr><tr><td align="left">auditoría</td><td align="left">todas las tablas: creado_en, creado_por, modificado_en, modificado_por, eliminado (borrado lógico)</td></tr><tr><td align="left">vendedor</td><td align="left">herencia 1 a 1 de usuario (su PK es también FK)</td></tr></table>>];
}