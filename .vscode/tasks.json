{
  // Tareas de VS Code para la demo.
  //   Ctrl+Shift+B          -> "Demo: arrancar TODO en un solo servidor"
  //   Ctrl+Shift+P -> "Tasks: Run Task" -> elegir otra
  //   F5                    -> lo mismo, pero con depurador (ver launch.json)
  //
  // La configuracion sale de backend\.env y frontend\.env.local, nunca de
  // la terminal. Ver GUIA_DEMO.md.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servidor: arrancar (interfaz + API en :8000)",
      "detail": "Construye la interfaz y la sirve junto a la API en http://localhost:8000",
      "type": "shell",
      "command": "${workspaceFolder}\\serve.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated", "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Servidor: PLAN B, sin base de datos",
      "detail": "Un solo servidor con datos fijos en la interfaz: sobrevive sin Neon y sin internet",
      "type": "shell",
      "command": "${workspaceFolder}\\serve.cmd memoria",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Demo: comprobar la base de datos",
      "detail": "Dice si backend\\.env conecta a Neon y cuantas filas hay",
      "type": "shell",
      "command": "${workspaceFolder}\\comprobar.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Desarrollo: API y Vite por separado (recarga en caliente)",
      "detail": "Dos servidores, 8000 y 5173. Para programar, no para presentar",
      "dependsOrder": "parallel",
      "dependsOn": ["Desarrollo: solo API", "Desarrollo: solo interfaz"],
      "problemMatcher": []
    },
    {
      "label": "Desarrollo: solo API",
      "type": "shell",
      "command": "${workspaceFolder}\\arrancar_api.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Desarrollo: solo interfaz",
      "type": "shell",
      "command": "${workspaceFolder}\\arrancar_ui.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Pruebas: backend (pytest)",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Pruebas: frontend (vitest)",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
