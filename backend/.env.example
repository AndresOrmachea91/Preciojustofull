# Copiar a backend/.env y completar. backend/.env NO se sube al repositorio.
APP_NOMBRE=PrecioJusto
APP_ENTORNO=desarrollo

# Cadena de Neon (rama production). Dejar vacia para arrancar con los
# repositorios en memoria, sin base de datos.
# Formato: postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require&channel_binding=require
BASE_DATOS_URL=

# Origenes permitidos para el frontend (CORS), separados por coma.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
