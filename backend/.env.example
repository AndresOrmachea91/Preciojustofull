# Copiar a backend/.env y completar. backend/.env NO se sube al repositorio.
APP_NOMBRE=PrecioJusto
APP_ENTORNO=desarrollo

# Cadena de Neon (rama production). Dejar vacia para arrancar con los
# repositorios en memoria, sin base de datos.
# Formato: postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require&channel_binding=require
BASE_DATOS_URL=

# Origenes permitidos para el frontend (CORS), separados por coma.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Secreto para firmar las sesiones (minimo 32 caracteres). Obligatorio con
# APP_ENTORNO=produccion. Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
SESION_HORAS=8

# Primer administrador: si estan las dos y no hay ningun administrador, se
# crea al arrancar la API. Alternativa por consola:
#   python -m src.infraestructura.adaptadores.entrada.cli.crear_admin --correo admin@...
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_CONTRASENA=
