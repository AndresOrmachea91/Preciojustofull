# Configuración del SERVIDOR (copiar a docker/.env.produccion y completar).
# Ese archivo no se sube al repositorio. Generar secretos con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Dominio (Caddy pide el HTTPS para este nombre) ------------------------
DOMINIO=preciojusto.ejemplo.bo
URL_PUBLICA=https://preciojusto.ejemplo.bo
CORS_ORIGENES=https://preciojusto.ejemplo.bo

# --- Base de datos ----------------------------------------------------------
POSTGRES_DB=preciojusto
POSTGRES_USER=preciojusto
POSTGRES_PASSWORD=
BASE_DATOS_URL=postgresql://preciojusto:CONTRASENA-DE-ARRIBA@db:5432/preciojusto

# --- Aplicación ---------------------------------------------------------------
APP_ENTORNO=produccion
JWT_SECRETO=
SESION_HORAS=8
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_CONTRASENA=

# --- Correo real (recuperar contraseña) -------------------------------------------
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_TLS=true
SMTP_REMITENTE=PrecioJusto <no-responder@ejemplo.bo>

# --- Recolector y respaldos ---------------------------------------------------------
RECOLECCION_HORA=11:00
RECOLECCION_REINTENTOS=3
RECOLECCION_ESPERA_MIN=60
RECOLECTAR_AL_INICIAR=0
RESPALDO_HORA=03:00
RESPALDO_DIAS=14
RESPALDO_AL_INICIAR=1
