# Configuración de los contenedores. Copiar a docker/.env y completar.
# docker/.env NO se sube al repositorio.

# --- Base de datos (contenedor "db") -----------------------------------
POSTGRES_DB=preciojusto
POSTGRES_USER=preciojusto
POSTGRES_PASSWORD=cambiar-esta-contrasena

# La API y el recolector se conectan al contenedor "db" por su nombre.
# La contraseña tiene que ser la misma de arriba.
BASE_DATOS_URL=postgresql://preciojusto:cambiar-esta-contrasena@db:5432/preciojusto

# --- Aplicación --------------------------------------------------------
APP_ENTORNO=produccion
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
SESION_HORAS=8
CORS_ORIGENES=http://localhost:8088

# Primer administrador: se crea al arrancar si todavía no hay ninguno.
ADMIN_INICIAL_CORREO=admin@preciojusto.bo
ADMIN_INICIAL_CONTRASENA=

# --- Recolector (contenedor "recolector") -------------------------------
# Una corrida por día, hora de Bolivia. Si falla, reintenta el mismo día.
RECOLECCION_HORA=11:00
RECOLECCION_REINTENTOS=3
RECOLECCION_ESPERA_MIN=60
RECOLECTAR_AL_INICIAR=0

# --- Respaldos (contenedor "respaldos") ---------------------------------
RESPALDO_HORA=03:00
RESPALDO_DIAS=7
RESPALDO_AL_INICIAR=0

# --- Correo (recuperar contraseña) ------------------------------------------
# Por defecto va a Mailpit (http://localhost:8025). Para un SMTP real:
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PUERTO=587
# SMTP_USUARIO=...
# SMTP_CLAVE=...
# SMTP_TLS=true
# Dónde abre la persona el enlace del correo:
URL_PUBLICA=http://localhost:8088
